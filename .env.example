# Copy this file to .env and adjust values for your environment.
# .env is loaded automatically by src/config.js.

# --- HTTP API ---------------------------------------------------------------
# Port for the Express API server (DLQ UI + REST endpoints).
PORT=3000

# --- PostgreSQL --------------------------------------------------------------
# Connection string for the jobs database.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/jobsdb

# --- Worker ----------------------------------------------------------------
# N: max number of jobs processed simultaneously by one worker process.
CONCURRENCY=4

# Max number of execution attempts per job before it is moved to 'dead'.
MAX_ATTEMPTS=3

# Exponential backoff base: runAt = now + base * 2^attempts + jitter.
BASE_BACKOFF_MS=1000

# Upper bound on the exponential backoff (prevents runaway delays).
MAX_BACKOFF_MS=300000

# Random jitter added on top of the backoff delay (0..MAX_JITTER_MS).
MAX_JITTER_MS=1000

# --- Stuck job recovery -----------------------------------------------------
# A job stuck in 'processing' longer than this is swept back to 'pending'.
STUCK_TIMEOUT_MS=60000

# How often the sweeper scans for stuck jobs.
SWEEP_INTERVAL_MS=10000

# --- Misc -------------------------------------------------------------------
# Poll interval of the worker claim loop.
POLL_INTERVAL_MS=200

# Directory where idempotent job output is written, keyed by job id.
OUTPUT_DIR=./outputs